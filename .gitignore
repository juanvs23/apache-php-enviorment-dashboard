# ─── Ignorar todo excepto el dashboard ──────────────────────────────────────
# Estrategia: ignorar todo en la raíz, des-ignorar solo lo que pertenece al
# dashboard. Así proyectos (twilight/, phpmyadmin/, etc.) quedan fuera.

/*

# ─── Dashboard ────────────────────────────────────────────────────────────
!index.php
!.htaccess
!env-loader.php
!auth-check.php
!fix-admin.php
!api.php
!setup.sh
!setup-phpmyadmin.sh
!setup-postgres.sh
!setup-services-all.sh
!SETUP.md
!SETUP-SERVICES.md
!UPGRADE.md
!migrations/
!migrations/**
!pgadmin4-optimize.conf
!robots.txt

# ─── Assets (Bootstrap) ───────────────────────────────────────────────────
!assets/
!assets/**

# ─── Lógica del dashboard ─────────────────────────────────────────────────
!dashboard-logic/
!dashboard-logic/**

# ─── Documentación ───────────────────────────────────────────────────────
!README.md
!CHANGELOG.md
!docs/
!docs/**

# ─── Template de entorno (sin credenciales reales) ────────────────────────
!.env.example

# ─── Robots.txt (bloquear crawlers) ───────────────────────────────────────
!robots.txt

# ─── Git ──────────────────────────────────────────────────────────────────
!.gitignore

# ─── Composer (dev dependencies, PHPUnit + BypassFinals) ──────────────────
dashboard-logic/vendor/

# ─── PHPUnit cache ────────────────────────────────────────────────────────
dashboard-logic/.phpunit.cache/

# ─── NO trackear el .env real con credenciales ────────────────────────────
.env

# ─── Basura del sistema ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log

# ─── Contexto local y opencode ────────────────────────────────────────────
.context.md
.atl/
