# ─── Bloquear archivos sensibles ─────────────────────────────────────────────
<Files ".env">
    Require all denied
</Files>

# ─── Auth check en TODOS los PHP requests (incluye subdirectorios) ──────────
php_value auto_prepend_file /mnt/vol/projects/apache/auth-check.php

# ─── Proteger dashboard-logic (solo wp-auto-login.php pasa) ────────────────
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Permitir el auto-login
RewriteRule ^dashboard-logic/wp-auto-login\.php - [L,NC]

# Bloquear todo lo demás en dashboard-logic
RewriteRule ^dashboard-logic/ - [F,NC]

# Permitir el dashboard y assets
RewriteRule ^(index\.php|assets/) - [L,NC]
</IfModule>
