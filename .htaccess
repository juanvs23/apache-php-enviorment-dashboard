# ─── Bloquear archivos sensibles ─────────────────────────────────────────────
<Files ".env">
    Require all denied
</Files>

# ─── Auth check en TODOS los PHP requests (incluye subdirectorios) ──────────
php_value auto_prepend_file /mnt/vol/projects/apache/dashboard-logic/auth-check.php

# ─── Rewrites + Proxy Vite ──────────────────────────────────────────────────
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Permitir auto-login de WordPress
RewriteRule ^dashboard-logic/wp-auto-login\.php - [L,NC]

# Bloquear acceso directo a dashboard-logic
RewriteRule ^dashboard-logic/ - [F,NC]

# Permitir dashboard y assets
RewriteRule ^(index\.php|assets/) - [L,NC]

# Proxy a Vite: rutas que solo existen en el dev server
# (Solo se activa si Vite está corriendo, sino Apache da 404 normal)
RewriteCond %{REQUEST_URI} ^/(@vite/|@fs/|@id/|src/|node_modules/vite/)
RewriteRule ^(.*)$ http://127.0.0.1:5173/$1 [P,L]
</IfModule>
