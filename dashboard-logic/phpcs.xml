<?xml version="1.0"?>
<ruleset name="Dev Dashboard">
    <description>PHP_CodeSniffer config for Dev Dashboard</description>

    <file>dashboard-logic/</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/views/*</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- Permitir variables con snake_case en vistas -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>*/views/*</exclude-pattern>
    </rule>

    <arg name="colors"/>
    <arg value="p"/>
</ruleset>
