# ─── Dev Dashboard ──────────────────────────────────────────────────────────
# Copiá este archivo como .env y cambiá los valores.
# NUNCA committees el .env real con credenciales.

DASHBOARD_KEY   = 'poné-tu-key-acá'
DASHBOARD_CLAVE = 'poné-tu-contraseña-acá'

# ─── phpMyAdmin ─────────────────────────────────────────────────────────────
# Si tenés phpMyAdmin en una ruta personalizada, definí la URL completa.
# PMA_URL = 'http://localhost/mi-phpmyadmin/'

# ─── Claves de acceso ────────────────────────────────────────────────────────
# Se muestran en el dashboard en Acciones > Claves de acceso.
# Dejá comentado lo que no quieras mostrar.
# PGA_EMAIL  = 'admin@localhost.com'
# PGA_PASS   = 'admin'
# DB_USER    = 'pgadmin'
# DB_PASS    = 'pgadmin123'
# MYSQL_USER = 'root'
# MYSQL_PASS = ''
# PMA_USER   = 'root'
# PMA_PASS   = ''
