# ─── Dev Dashboard ──────────────────────────────────────────────────────────
# Copiá este archivo como .env y cambiá los valores.
# NUNCA commitees el .env real con credenciales.

# ─── Base de datos MySQL (obligatorio) ───────────────────────────────────────
DB_DRIVER = 'mysql'
DB_HOST   = 'localhost'
DB_PORT   = '3306'
DB_NAME   = 'apache-dashboard'
DB_USER   = 'tu-usuario-mysql'
DB_PASS   = 'tu-contraseña-mysql'

# ─── phpMyAdmin (opcional) ───────────────────────────────────────────────────
# Si tenés phpMyAdmin, definí la URL para activar el botón en el dashboard.
# PMA_URL = 'http://localhost/phpmyadmin/'

# ─── Modo desarrollo ──────────────────────────────────────────────────────────
# 1 = phpinfo() y otras herramientas de debug disponibles (solo admin)
# 0 = deshabilitado para staging/producción
DEV_MODE = '1'

# ─── Entorno de seed ──────────────────────────────────────────────────────────
# dev     = contraseñas conocidas para desarrollo local (default)
# staging = contraseñas aleatorias fuertes, se muestran una sola vez
# prod    = solo admin, sin usuarios de prueba
# SEED_ENV = 'dev'

# ─── Logs en vivo (opcional) ──────────────────────────────────────────────────
# Ruta personalizada al error log de Apache. Si no se define, el dashboard
# la detecta automáticamente (HTTPD_ROOT, sites-enabled, rutas comunes).
# APACHE_ERROR_LOG = '/var/log/apache2/error.log'

# ─── Claves de acceso (informativas, se muestran en el dashboard) ────────────
# Comentá las que no quieras mostrar.
# PGA_EMAIL  = 'admin@localhost.com'
# PGA_PASS   = 'admin'
# MYSQL_USER = 'root'
# MYSQL_PASS = ''
# PMA_USER   = 'root'
# PMA_PASS   = ''
